{
	"name": "pictum",
	"private": true,
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.3",
	"description": "Framework-independent Pictum asset helpers for JavaScript.",
	"author": "Pictum",
	"license": "MIT",
	"homepage": "https://github.com/usepictum/pictum/tree/main/integrations/javascript#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/usepictum/pictum.git",
		"directory": "integrations/javascript"
	},
	"bugs": {
		"url": "https://github.com/usepictum/pictum/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "tsdown --watch",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"play": "pnpm build && pnpm --filter @pictum/playground dev",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@tsconfig/strictest": "^2.0.8",
		"git-cliff": "2.13.1",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
